@baseUrl = https://localhost:7126

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Refresh
POST {{baseUrl}}/api/auth/refresh

### Logout
POST {{baseUrl}}/api/auth/logout

### Create Recipe
# @name createRecipe
POST {{baseUrl}}/api/recipes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Test Recipe",
  "instructions": "Mix and bake",
  "servingSize": 4,
  "ingredients": [
    { "ingredientName": "Flour", "quantity": 2, "unit": "Cup" }
  ]
}

### List Recipes
GET {{baseUrl}}/api/recipes
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get Recipe by Id
GET {{baseUrl}}/api/recipes/{{createRecipe.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Update Recipe
PUT {{baseUrl}}/api/recipes/{{createRecipe.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Updated Test Recipe",
  "instructions": "Mix, bake, and cool",
  "servingSize": 6,
  "ingredients": [
    { "ingredientName": "Flour", "quantity": 3, "unit": "Cup" },
    { "ingredientName": "Sugar", "quantity": 1, "unit": "Cup" }
  ]
}

### Delete Recipe
DELETE {{baseUrl}}/api/recipes/{{createRecipe.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get Recipe by Id (should 404 after delete)
GET {{baseUrl}}/api/recipes/{{createRecipe.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create Meal Plan
# @name createMealPlan
POST {{baseUrl}}/api/mealplans
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "weekStartDate": "2026-07-20"
}

### Add Entry to Meal Plan
POST {{baseUrl}}/api/mealplans/{{createMealPlan.response.body.$.id}}/entries
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "recipeId": "{{createRecipe.response.body.$.id}}",
  "date": "2026-07-20",
  "mealType": "Dinner"
}

### Get Meal Plan
GET {{baseUrl}}/api/mealplans/{{createMealPlan.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### List Meal Plans
GET {{baseUrl}}/api/mealplans
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create Second Recipe (shares Flour in Cups, and adds Sugar in Grams)
# @name createRecipe2
POST {{baseUrl}}/api/recipes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Pancakes",
  "instructions": "Mix and cook",
  "servingSize": 4,
  "ingredients": [
    { "ingredientName": "Flour", "quantity": 1, "unit": "Cup" },
    { "ingredientName": "Sugar", "quantity": 50, "unit": "Gram" }
  ]
}

### Add Second Recipe to Meal Plan
POST {{baseUrl}}/api/mealplans/{{createMealPlan.response.body.$.id}}/entries
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "recipeId": "{{createRecipe2.response.body.$.id}}",
  "date": "2026-07-21",
  "mealType": "Breakfast"
}

### Get Shopping List
GET {{baseUrl}}/api/mealplans/{{createMealPlan.response.body.$.id}}/shopping-list
Authorization: Bearer {{login.response.body.$.accessToken}}
